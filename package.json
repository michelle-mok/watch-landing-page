{
    "name": "watch-landing-page",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "model:optimise": "gltf-transform resize assets-src/ChronographWatch.glb /tmp/glb-resized.glb --width 1024 --height 1024 && gltf-transform webp /tmp/glb-resized.glb /tmp/glb-webp.glb --lossless true && gltf-transform meshopt /tmp/glb-webp.glb public/models/ChronographWatch-opt.glb --level high"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.7.0",
        "gsap": "^3.15.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "three": "^0.185.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@gltf-transform/cli": "^4.5.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/three": "^0.185.4",
        "@vitejs/plugin-react": "^6.1.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2"
    }
}
